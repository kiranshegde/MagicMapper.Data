<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>
			IDataReader and ADO.NET mapping extensions for MagicMapper.
			Community-maintained fork of AutoMapper.Data.
		</Description>
		<Company>MagicMapper Community</Company>
		<VersionPrefix>14.0.1</VersionPrefix>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Authors>Kiran Hegde</Authors>
		<TargetFramework>net8.0</TargetFramework>
		<AssemblyName>MagicMapper.Data</AssemblyName>
		<PackageId>MagicMapper.Data</PackageId>
		<PackageTags>MagicMapper.Data</PackageTags>
		<PackageProjectUrl>https://github.com/kiranshegde/MagicMapper.Data</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/kiranshegde/MagicMapper.Data</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<RepositoryBranch>master</RepositoryBranch>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\MagicMapper.Data.snk</AssemblyOriginatorKeyFile>
		<PublicSign Condition=" '$(OS)' != 'Windows_NT' ">true</PublicSign>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="MagicMapper" Version="14.0.1" />
	</ItemGroup>

</Project>